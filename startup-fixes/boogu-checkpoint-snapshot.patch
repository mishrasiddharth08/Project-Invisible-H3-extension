+    def test_checkpoint_registration_reads_a_stable_snapshot(self):
+        path = Path('boogu.safetensors').resolve()
+        asset = Asset(path, 'base', 'bf16')
+        class MutatingValues(dict):
+            def values(self):
+                iterator = iter(super().values())
+                owner = self
+                class Values:
+                    def __iter__(self):
+                        first = next(iterator)
+                        yield first
+                        owner['concurrent'] = first
+                        yield from iterator
+                return Values()
+        checkpoint = SimpleNamespace(
+            filename=str(path), name='old', title='old', short_title='old',
+            shorthash=None, ids=[], register=lambda: None)
+        checkpoints = MutatingValues(old=checkpoint)
+        modules = ModuleType('modules')
+        modules.sd_models = SimpleNamespace(checkpoints_list=checkpoints)
+        with patch.dict('sys.modules', {'modules': modules}), patch.object(
+                forge.assets, 'scan', return_value=[asset]):
+            forge.register_checkpoints()
+        self.assertEqual(checkpoint.name, 'Boogu — base — boogu')
+
