index 0000000..c25d69d
--- /dev/null
+++ b/tests/test_refresh_after_rename.py
@@ -0,0 +1,76 @@
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+
+def load_candidate():
+    root = Path(__file__).resolve().parents[1]
+    package = types.ModuleType("candidate_model_autolink")
+    package.__path__ = [str(root / "model_autolink")]
+    stubs = {
+        "compatibility": {"DEFAULT_QUANT_PRIORITY": {}},
+        "fingerprint": {"quantization": lambda *_: "plain"},
+        "resolver": {"ResolutionError": RuntimeError, "Resolver": object},
+        "smartname": {"smart_rename": lambda *_args, **_kwargs: []},
+    }
+    modules = {"candidate_model_autolink": package}
+    for name, values in stubs.items():
+        module = types.ModuleType(f"candidate_model_autolink.{name}")
+        vars(module).update(values)
+        modules[module.__name__] = module
+    previous = {name: sys.modules.get(name) for name in modules}
+    sys.modules.update(modules)
+    try:
+        spec = importlib.util.spec_from_file_location(
+            "candidate_model_autolink.integration",
+            root / "model_autolink" / "integration.py",
+        )
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        return module
+    finally:
+        for name, value in previous.items():
+            if value is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = value
+
+
+integration = load_candidate()
+
+
+def test_rename_rebuilds_forge_module_list_before_return():
+    files = {"downloaded-int4.safetensors"}
+    module_list = {}
+    calls = []
+
+    def refresh():
+        calls.append("refresh")
+        module_list.clear()
+        module_list.update({name: f"models/{name}" for name in files})
+        return sorted(module_list)
+
+    def rename():
+        calls.append("rename")
+        files.remove("downloaded-int4.safetensors")
+        files.add("qwen3vl_32b_minimax_h3_int4_convrot.safetensors")
+        return [("downloaded-int4.safetensors", "qwen3vl_32b_minimax_h3_int4_convrot.safetensors")]
+
+    result = integration._refresh_after_rename(refresh, rename, lambda: calls.append("rescan"))
+
+    assert calls == ["refresh", "rename", "refresh", "rescan"]
+    assert result == ["qwen3vl_32b_minimax_h3_int4_convrot.safetensors"]
+    assert list(module_list) == result
+
+
+def test_no_rename_keeps_single_forge_refresh():
+    calls = []
+    result = integration._refresh_after_rename(
+        lambda: calls.append("refresh") or ["existing.safetensors"],
+        lambda: calls.append("rename") or [],
+        lambda: calls.append("rescan"),
+    )
+    assert calls == ["refresh", "rename", "rescan"]
+    assert result == ["existing.safetensors"]
